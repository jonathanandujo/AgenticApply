@AgenticApply.Api_HostAddress = http://localhost:5000

### Get all jobs
GET {{AgenticApply.Api_HostAddress}}/jobs
Accept: application/json

### Get the top 10 evaluated jobs
GET {{AgenticApply.Api_HostAddress}}/jobs/top
Accept: application/json

### Get a job by ID
GET {{AgenticApply.Api_HostAddress}}/jobs/4481802072
Accept: application/json

### Get a missing job (expected 404)
GET {{AgenticApply.Api_HostAddress}}/jobs/does-not-exist
Accept: application/json

### Re-evaluate a job using the configured Ollama model
POST {{AgenticApply.Api_HostAddress}}/jobs/4481802072/reevaluate
Content-Type: application/json

{}

### Re-evaluate a job with a model override
POST {{AgenticApply.Api_HostAddress}}/jobs/4481802072/reevaluate
Content-Type: application/json

{
  "model": "llama3.1:8b"
}

### Get aggregate statistics
GET {{AgenticApply.Api_HostAddress}}/stats
Accept: application/json

### Get the worker's LinkedIn jobs-search URL
GET {{AgenticApply.Api_HostAddress}}/settings/linkedin-search
Accept: application/json

### Update the worker's LinkedIn jobs-search URL
PUT {{AgenticApply.Api_HostAddress}}/settings/linkedin-search
Content-Type: application/json

{
  "jobsUrl": "https://www.linkedin.com/jobs/search/?keywords=software%20engineer&location=United%20States"
}

### Get the OpenAPI document in Development
GET {{AgenticApply.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###
